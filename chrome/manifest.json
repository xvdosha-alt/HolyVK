{
  "manifest_version": 3,
  "name": "HolyVK",
  "version": "2.1.0",
  "description": "Добавляет ники из журнала прямо в чаты VK для модераторов!",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://journal.dosha.pw/*",
    "https://vk.ru/*",
    "https://*.vk.ru/*",
    "https://vk.com/*",
    "https://*.vk.com/*",
    "https://web.vk.me/*"
  ],
  "action": {
    "default_title": "HolyVK",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vk.ru/*",
        "https://*.vk.ru/*",
        "https://vk.com/*",
        "https://*.vk.com/*",
        "https://web.vk.me/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
